# ============================================================
# Unified AI Job Application Platform — environment template
# Copy to .env and fill in. Never commit .env.
# ============================================================

# ---- Safety (leave both as-is until you have watched a dry run) ----
# While DRY_RUN is true nothing is ever submitted to a real portal.
DRY_RUN=true
# AUTO_APPLY must be explicitly enabled before any application is sent.
AUTO_APPLY=false

# ---- Database ----
# SQLite by default. Point at postgresql+psycopg://user:pass@host/db to share.
# DATABASE_URL=sqlite:///data/jobpilot.db

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Required if API_HOST is not loopback. Startup fails without it.
API_KEY=

# ---- Matching ----
MIN_MATCH_SCORE=0.70
MAX_APPLICATIONS_PER_COMPANY=2
COMPANY_WINDOW_DAYS=1
MAX_APPLICATIONS_PER_RUN=10

# ---- AI / RAG (local-first via Ollama) ----
LLM_MODEL=phi3
EMBED_MODEL=mxbai-embed-large
EMBED_COLLECTION=jobpilot_context
# Below this similarity a stored answer is NOT reused — the run pauses and
# asks you instead. Raise it to be asked more often.
ANSWER_CONFIDENCE_THRESHOLD=0.82

# ---- Browser ----
BROWSER=firefox
HEADLESS=false
PAGE_TIMEOUT_MS=30000
REQUEST_DELAY_SECONDS=3.0

# ---- Resume generation ----
LATEX_COMMAND=pdflatex

# ---- Google ----
GMAIL_CREDENTIALS_FILE=.credentials/client_secret.json
GMAIL_TOKEN_FILE=.credentials/token.json
GOOGLE_SHEET_ID=

# ---- Portal credentials (optional) ----
# Most portals are better driven by an interactive login that saves a browser
# session. Set these only where a scripted login is genuinely needed.
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=
# NAUKRI_EMAIL=
# NAUKRI_PASSWORD=

# ---- Logging ----
LOG_LEVEL=INFO
